# Copy these exports into the remote shell or its secret manager.
# Never commit real keys/tokens.

export DASHSCOPE_API_KEY="replace-with-dashscope-key"
# Replace the workspace id and region with the endpoint shown in Model Studio.
export QWEN2_5_VL_BASE_URL="https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"

# HF_TOKEN is optional for the public Space and required for a private Space.
export HF_TOKEN="replace-with-hugging-face-token"
export GOT_OCR2_GRADIO_SOURCE="your-account/your-private-got-ocr2-space"

export PADDLEOCR_ACCESS_TOKEN="replace-with-ai-studio-access-token"
# Only set this when using a PaddleOCR proxy/private compatible service.
# export PADDLEOCR_BASE_URL="https://your-paddleocr-api.example.com"

export OCR_MANCHU_PROJECT_ROOT="/root/code/OCR_Manchu"
export OCR_MANCHU_REC_ROOT="/root/code/Manchu_Recognition_Data"
export OCR_MANCHU_OUTPUT_ROOT="/root/code/OCR_Manchu/outputs"
